/store_trailers/steam/apps/3259780/1262133872/14431e1f6b8f5ccd63847128859ae04581f16f77/1779757686/hls_264_master.m3u8?t=1781017086","poster":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257343108/5f3ae6cb06dca6fcdcfe0e3e78e7f905fb8da7bb/movie_full.jpg?t=1781017086","name":"TCH_Trailer long"}],"news_v":2,"news":[{"t":"FINAL FANTASY RESONANCE IS OUT NOW!","d":"2026-10-22T17:00:48Z","u":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114033529","k":"news","x":"FINAL FANTASY RESONANCE, the first HD-2D title in the series, is out now! What if FINAL FANTASY had continued to push the limits of pixel art? Experie…"},{"t":"FINAL FANTASY RESONANCE Demo Available Now!","d":"2026-09-03T16:00:37Z","u":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814443842","k":"news","x":"Begin your journey in FINAL FANTASY RESONANCE, experiencing the story from the opening through the end of Chapter 1. Engage in evolved turn-based batt…"},{"t":"FINAL FANTASY RESONANCE is available for pre-purchase now!","d":"2026-06-09T16:25:23Z","u":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1834602721202361","k":"news","x":"What if FINAL FANTASY had continued to push the limits of pixel art and evolved from its classic roots? The first FINAL FANTASY to join the HD‑2D line…"}],"tcv":{"d":"2026-11-20","pos":[["玩了120幾個小時才破關，真的太好玩了 滿滿的2D時期FF的元素 練功、探索、配裝、虐怪、打寶，一玩就停不下來 劇情演出也是HD-2D的天花板 極限技、主線過場動畫充滿動態感 沒想到2D也能有3D運鏡般的畫面表現 這才是原汁原味的FF啊 FF7重製版完全被比下去了 戰鬥音樂非常洗腦，跟6代、7代有得拚😂",122.2,"2026-11-14"],["90分的作品，劇情後面有點太惱了，但戰鬥和玩法真有FF6那味，FF最好玩還是FF4、FF6。兩者劇情、遊戲都是最頂尖的。",62.0,"2026-11-18"],["首先白金認證。 SE，這就是老玩家們想要的FF啊！ 畫面：100/10 HD-2D打磨這麼多年後性能的極致體現，我愛死這種風格了。華麗而不失韻味，以後HD-2D沒有這個程度說不定要挨噴。 音樂：8/10 曲子挺好的，旋律優美也符合情景。就是複用得有點多，而且沒有特別記憶深刻的曲子，有點可惜了。 劇情：7.5/10 太王道了。雖然我本來也很喜歡王道劇情，但是整個下來感覺便當發得有點隨便，做不到引爆情…",66.9,"2026-11-18"]],"neg":[["粉絲服務向的遊戲。 遊戲看起來是賣情懷的低成本手機遊戲， 花裡胡哨的東西不少，重要的地方卻沒做好。 如果很喜歡ＦＦ系列作品， 想看些眼熟的元素是可以試試看的... 畫面上 點陣圖，人物ＣＧ圖，３Ｄ建模分開來看是不錯的。 可是實際遊玩的畫面卻沒有很好的融合在一起， 看起來總覺得不對勁。 如果要這樣搭配至少要能調整到遊戲內過場動畫那種等級才對。 遊戲性 難得又可以用飛空艇在大地圖上飛，這點我很喜歡。 …",65.3,"2026-11-14"],["這遊戲是塊雞肋，食之無味棄之可惜，劇情很無聊玩到快睡著，戰鬥系統也很普通，沒啥戰鬥詭計可以玩，就是最早期的JRPG一樣，先玩了空之軌跡二再過來玩這款遊戲真的感覺有落差，幻兵帶來的系統也沒特別有深度，原價入坑感覺是冤大頭。",7.5,"2026-11-15"],["極度離譜毫無邏輯的劇情 已經不知道要從哪裡吐槽起了 ....",27.6,"2026-11-16"]],"n":419},"base":{"zh":"tc","soon":false,"ea":false,"free":false,"orig":149000,"rv":95,"ws":false}}